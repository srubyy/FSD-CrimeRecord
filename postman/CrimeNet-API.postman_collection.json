	"item": [
		{
			"name": "Auth",
			"description": "Authentication endpoints: staff registration, credential validation, JWT token issuance, and error handling.",
			"item": [
				{
					"name": "POST /api/auth/login - Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response body contains valid token and Admin user', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('success');",
									"    pm.expect(jsonData.token).to.be.a('string').that.is.not.empty;",
									"    pm.expect(jsonData.user.username).to.eql('admin_vance');",
									"    pm.expect(jsonData.user.role).to.eql('Admin');",
									"    pm.expect(jsonData.user).to.not.have.property('passwordHash');",
									"    pm.environment.set('admin_token', jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin_vance\",\n  \"password\": \"AdminPass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
