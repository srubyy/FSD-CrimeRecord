# ====================================================
# Stage 1: Frontend Production Build
# ====================================================
FROM node:20-alpine AS builder
WORKDIR /app

# Copy dependency manifests & install all dependencies (including devDependencies for Vite)
COPY package.json package-lock.json ./
RUN npm ci

# Copy frontend source files
COPY src/ ./src/
COPY public/ ./public/
COPY index.html vite.config.js tailwind.config.js postcss.config.js .oxlintrc.json ./

# Accept build argument for Vite API URL and set environment variable
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build Vite static production bundle
RUN npm run build

# ====================================================
# Stage 2: Production Nginx Server
# ====================================================
FROM nginx:alpine AS runner

# Copy built SPA bundle to Nginx html directory
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration for SPA routing & gzip
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
